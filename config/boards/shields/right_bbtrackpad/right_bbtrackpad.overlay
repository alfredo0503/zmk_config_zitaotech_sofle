/*
 * Right A320 BlackBerry-style trackpad shield for ZitaoTech Sofle.
 * Derived from the seller's left_bbtrackpad A320 implementation and
 * the known-working right_trackpoint electrical/split path.
 *
 * Assumed right module interface (from existing right_trackpoint):
 *   I2C SDA   P0.07
 *   I2C SCL   P1.08
 *   MOTION_N  P0.14   (used by custom_driver_right/a320.c)
 *   LED PWM   P0.04
 *   A320 I2C  0x3B
 */

/* v6.4.11: keep the physical rotary push and BB pad click positions aligned
 * with the Studio physical layout on the RIGHT peripheral too.
 * Rotary pushes: RC(6,7) / RC(6,15) -> top logical special slots.
 * BB pad clicks: RC(6,6) / RC(6,14) -> middle logical special slots.
 */
&default_transform {
    rows = <7>;
    map = <
RC(0,0)  RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(6,7)             RC(6,15)           RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13)
RC(1,0)  RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                                         RC(1,8)  RC(1,9)  RC(1,10) RC(1,11) RC(1,12) RC(1,13)
RC(2,0)  RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(6,6)             RC(6,14)           RC(2,8)  RC(2,9)  RC(2,10) RC(2,11) RC(2,12) RC(2,13)
RC(3,0)  RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)  RC(5,7)  RC(5,6)    RC(5,15) RC(5,14)  RC(3,8)  RC(3,9)  RC(3,10) RC(3,11) RC(3,12) RC(3,13)
         RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)                                         RC(4,8)  RC(4,9)  RC(4,10) RC(4,11) RC(4,12)
    >;
};

/ {
    chosen {
        /* Reuse the right side's proven LED implementation/pin. */
        zmk,custom_led = &custom_led;
    };

    custom_led: pwmledto {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm1 0 PWM_USEC(20) PWM_POLARITY_NORMAL>;
        };
    };

};

/ {
    behaviors {
        mled: mled {
            compatible = "zmk,behavior-mouse-led-sync";
            #binding-cells = <0>;
        };
    };
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&pwm1_default>;
    pinctrl-1 = <&pwm1_sleep>;
    pinctrl-names = "default", "sleep";
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    bbtrackpad: a320@3b {
        compatible = "avago,a320";
        reg = <0x3B>;
        status = "okay";
    };
};

/*
 * Deliberately keep the existing RIGHT pointing split ID/path.
 * On the LEFT central, trackpoint_split/trackpoint_listener already exists
 * and is proven by the current right TrackPoint firmware.  This avoids a
 * conflict with the LEFT local bbtrackpad_listener when both sides are A320.
 */
/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackpoint_split: trackpoint_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };
};

&trackpoint_split {
    device = <&bbtrackpad>;
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 7)>,
                    <NRF_PSEL(TWIM_SCL, 1, 8)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 7)>,
                    <NRF_PSEL(TWIM_SCL, 1, 8)>;
            low-power-enable;
        };
    };

    pwm1_default: pwm1_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 4)>;
        };
    };

    pwm1_sleep: pwm1_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 4)>;
            bias-pull-down;
        };
    };
};
